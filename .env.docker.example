# ============================================================
# Parkomat — משתני סביבה לשרת (העתק ל-.env לצד ה-docker-compose)
# ============================================================
# הקובץ הזה הוא תבנית בלבד. ה-.env האמיתי מכיל סודות ואינו נכנס ל-git
# ולא לתמונת ה-Docker.

# ===== חובה — בלעדיהם השרת מסרב לעלות =====

# Postgres של Supabase. חייב להיות ה-pooler (פורט 6543), ולא המארח הישיר
# (db.<ref>.supabase.co הוא IPv6 בלבד ולא ייפתר מהקונטיינר).
DATABASE_URL=postgresql://USER:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres

# HiveMQ Cloud — ה-Master מאזין בלבד
HIVEMQ_HOST=xxxxxxxx.s1.eu.hivemq.cloud
HIVEMQ_PORT=8883
MASTER_USERNAME=master
MASTER_PASSWORD=

# ===== מומלץ =====

# מזהה הלקוח מול HiveMQ. קבוע (ולא אקראי) עם clean:false, כדי שהברוקר ישמור
# הודעות בזמן שהשרת למטה ויימסור אותן בהתחברות הבאה.
# ⚠️ שני מופעים עם אותו מזהה מנתקים זה את זה — מופע אחד בלבד.
#
# ⚠️ חייב להיות **ייחודי ומפורש**, ולא שם גנרי כמו "master": חיבור של כל לקוח אחר
# עם אותו מזהה ועם clean:true מוחק את ה-session ואת כל התור שבו — בשקט, בלי שגיאה.
# כך אבדו הודעות של 3.6 ימים ב-22-26/07/2026. אם יש כמה פריסות (prod/staging),
# לכל אחת מזהה משלה. החלפת המזהה דורשת נוהל — ראה master/README.md.
MASTER_CLIENT_ID=parkomat-master-subscriber-prod

PORT=4000

# רלוונטי רק אם הדשבורד מוגש מדומיין *אחר* מה-API. בפריסה הזו הוא מוגש
# מאותו קונטיינר ואותו origin, ולכן אפשר להשאיר כברירת מחדל.
# DASHBOARD_ORIGIN=https://parkomat.example.com

# ===== אופציונלי — עוזר ה-AI (פרקובוט) =====
# בלעדיהם הצ'אט פשוט מדווח שהוא אינו מוגדר; שאר המערכת עובדת רגיל.
# AI_PROVIDER=groq
# GROQ_API_KEY=
# GROQ_MODEL=

# ============================================================
# ⚠️ שלושת אלה הם ארגומנטי **בנייה** — לא משתני ריצה
# ============================================================
# Vite מטמיע אותם לתוך קובץ ה-JS בזמן הבנייה. שינוי שלהם מחייב
#     docker compose up -d --build
# ובלי --build הערך הישן נשאר בתמונה, בלי שום סימן.
#
# בלעדיהם הדשבורד עולה ואומר "האימות אינו מוגדר בדשבורד" — שרת תקין
# לגמרי, מסך שאי אפשר להיכנס בו.

# כתובת פרויקט Supabase, כפי שהיא ב-Project Settings → API.
VITE_SUPABASE_URL=https://xxxxxxxx.supabase.co

# ⚠️ ה-publishable / anon key **בלבד**. הוא נועד לדפדפן ו-RLS מגן עליו.
# ה-secret key עוקף RLS לחלוטין — אם הוא ייצרב לכאן, כל מי שפותח את
# הדשבורד מקבל גישה מלאה לכל הנתונים.
VITE_SUPABASE_PUBLISHABLE_KEY=

# true  = הדשבורד קורא ישירות מ-Supabase (תוכנית א', ברירת המחדל)
# false = הכול חוזר לעבור דרך השרת (תוכנית ב')
# ראה dashboard/src/services/dataSource.js — שתי הזרועות מחזירות אותו מבנה.
VITE_SUPABASE_DIRECT=true

# ============================================================
# אימות בצד השרת — נדרש להזמנת משתמשים ולאימות אסימונים
# ============================================================
# ⚠️ בלי SUPABASE_URL ו-SUPABASE_SECRET_KEY, POST /api/users/invite מחזיר
# שגיאה. שאר המערכת עובדת — ולכן זה נגלה רק כשמישהו מנסה לצרף עובד.

SUPABASE_URL=https://xxxxxxxx.supabase.co

# ⚠️⚠️ **המפתח הסודי. לעולם לא בדשבורד ולא בדפדפן.** הוא עוקף RLS, כלומר
# מי שמחזיק בו רואה וכותב הכול. כאן הוא בטוח: הוא נשאר בצד השרת.
SUPABASE_SECRET_KEY=

# ספק האימות. 'supabase' הוא הפעיל; 'selfhosted' הוא המסלול הדורמנטי
# שכתוב ומכוסה בבדיקות אך אינו בשימוש (ראה master/auth/provider.js).
AUTH_PROVIDER=supabase

# ===== רלוונטי רק ל-AUTH_PROVIDER=selfhosted =====
# AUTH_JWT_SECRET=
# AUTH_JWT_ISSUER=parkomat

# ============================================================
# אופציונלי — שערי האימות (npm run gates)
# ============================================================
# שלושה שערים בודקים את המסלול ש**באמת פועל**: הדשבורד קורא מ-PostgREST,
# ו-RLS מעניק קריאה ל-authenticated בלבד. בלי משתמש הם אינם יכולים לרוץ,
# ו-`npm run gates` יחזיר קוד 2 — "לא רץ", לא "עבר".
# משתמש רגיל מספיק. קריאה בלבד.
# PARITY_EMAIL=
# PARITY_PASSWORD=
