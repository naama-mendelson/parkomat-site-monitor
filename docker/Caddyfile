# ============================================================
# Caddyfile — HTTPS ו-origin אחד לכל המערכת
# ============================================================
# ⚠️ **מה זה מתקן, וזה לא "הצפנה" סתם.** התעבורה ל-Supabase כבר מוצפנת
# (HTTPS), ולכן הסיסמה והנתונים אינם ניתנים להאזנה בדרך. הבעיה הייתה
# אחרת: **הדשבורד עצמו הוגש ב-HTTP רגיל**, כלומר קוד ה-JavaScript הגיע
# לא מוצפן. מי שיושב על אותה רשת משרדית ויכול ליירט מזריק שורה לקוד
# בדרך, קוראת את האסימון מ-localStorage ושולחת אותו החוצה.
#
# ⚠️ **וזו הפרצה שעוקפת את האימות הדו-שלבי לגמרי.** אסימון שכבר עבר
# אתגר נושא aal2 בעצמו; מי שגונב אותו נכנס בלי לעבור שום אתגר. לכן
# HTTPS קודם ל-2FA בסדר החשיבות, גם אם 2FA נבנה ראשון.
{
	# ⚠️ CA מקומי, ולא Let's Encrypt — אין דומיין ציבורי ואין פורט 80
	# פתוח לאינטרנט, כלומר אין דרך לאמת בעלות. Caddy מנפיק תעודה מ-CA
	# משלו.
	#
	# ⚠️ **ולכן חייבים להתקין את שורש ה-CA בשמונת המחשבים.** בלי זה
	# הדפדפן מציג אזהרה בכל כניסה, המשתמשים לומדים ללחוץ "המשך בכל זאת",
	# ואז התקיפה חוזרת לעבוד — כי בדיוק כך היא נראית. אזהרה שמלמדים
	# להתעלם ממנה גרועה מאין אזהרה.
	local_certs
}

# הכתובת מגיעה מ-.env. לדוגמה: https://parkomat.local או https://192.168.1.50
{$SITE_ADDRESS:https://localhost} {
	encode gzip

	# ============================================================
	# origin אחד — וזה מבטל את CORS במקום להגדיר אותו
	# ============================================================
	# services/api.js משתמש בכתובות יחסיות כש-VITE_API_BASE ריק. מרגע
	# שהדשבורד וה-API יושבים על אותו origin, אין בקשה חוצת-מקורות בכלל.
	#
	# ⚠️ ומכאן דבר שחייב להיאמר: **VITE_API_BASE חייב להישאר ריק.** אם
	# הוא מצביע ל-http://SERVER-IP:4000, דף שנטען ב-HTTPS ינסה לקרוא
	# ל-HTTP — והדפדפן יחסום את זה כתוכן מעורב. המסך ייטען, והנתונים לא
	# יגיעו, בלי שום שגיאה מובנת.
	handle /api/* {
		# ⚠️ flush_interval -1 עבור SSE: בלעדיו ה-proxy אוגר את הזרם
		# והעדכונים החיים מגיעים בגושים או בכלל לא.
		reverse_proxy parkomat:4000 {
			flush_interval -1
		}
	}

	handle /health {
		reverse_proxy parkomat:4000
	}

	handle {
		reverse_proxy web:80
	}

	header {
		# ⚠️ HSTS רק אחרי שה-CA מותקן ו-HTTPS עובד. הדפדפן זוכר את זה
		# לשנה, וכיבוי מוקדם מדי נועל את המשתמשים מחוץ ל-HTTP שעדיין עובד.
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
}
