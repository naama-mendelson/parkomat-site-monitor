# ============================================================
# Caddyfile — origin אחד, בתוך רשת ה-Docker בלבד
# ============================================================
# ⚠️ **אין כאן TLS, וזה מכוון.** את ה-TLS מסיים Cloudflare, עם תעודה
# אמיתית שכל דפדפן וכל טלפון מכירים מראש. ה-proxy הזה מקשיב על 80 בתוך
# רשת ה-Docker ואינו חשוף לשום מקום — cloudflared הוא הדבר היחיד שפונה
# אליו, ו**אין פורט מפורסם למארח בכלל**.
#
# ============================================================
# ⚠️ למה לא CA מקומי, וזה תוקן אחרי שנבנה
# ============================================================
# הגרסה הראשונה השתמשה ב-`tls internal`: Caddy מנפיק תעודה מ-CA משלו,
# וכל מחשב היה צריך להתקין את שורש ה-CA. זה נדחה, ובצדק:
#   1. **טלפונים.** התקנת CA ב-iOS/Android היא סיוט, ובחברה עם הרבה
#      עובדים היא לא ריאלית.
#   2. **הדשבורד הוא PWA** — יש manifest.json, sw.js והתראות Push.
#      דפדפנים מסרבים לרשום service worker מעל http:// רגיל, ולכן
#      האפליקציה בטלפון לא יכולה הייתה לעבוד בכלל. תעודה שאינה מוכרת
#      אינה פותרת את זה.
{
	# אין הנפקת תעודות — Cloudflare עושה את זה.
	auto_https off
	# ⚠️ ממשק הניהול של Caddy מאפשר שינוי תצורה בזמן ריצה. אין לו שימוש
	# כאן, וכל דבר שאין לו שימוש ופתוח הוא רק שטח תקיפה.
	admin off
}

:80 {
	encode gzip

	# ============================================================
	# origin אחד — מבטל את CORS במקום להגדיר אותו
	# ============================================================
	# ⚠️ services/api.js משתמש בכתובות יחסיות כש-VITE_API_BASE ריק, ולכן
	# הוא **חייב להישאר ריק**. אם הוא מצביע לכתובת מפורשת, דף שנטען
	# מ-Cloudflare ינסה לפנות לשרת ישירות — והדפדפן יחסום. המסך ייטען,
	# הנתונים לא יגיעו, ובלי שום שגיאה מובנת.
	handle /api/* {
		# ⚠️ flush_interval -1 עבור SSE: בלעדיו ה-proxy אוגר את הזרם
		# והעדכונים החיים מגיעים בגושים או בכלל לא.
		reverse_proxy parkomat:4000 {
			flush_interval -1
		}
	}

	handle /health {
		reverse_proxy parkomat:4000
	}

	handle {
		reverse_proxy web:80
	}

	header {
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
}
