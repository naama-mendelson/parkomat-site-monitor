# ==========================================================
# Parkomat — .gitignore שורשי
# חל על כל הפרויקט. לכל תת-תיקייה יש .gitignore משלה בנוסף.
# ==========================================================

# ===== 🔴 סודות — לעולם לא לעלות =====
.env
.env.*
!.env.example
!.env.test.example
!.env.docker.example

# סיסמת ה-HiveMQ שנצרבת לבינארי של הסוכן בזמן build. הערך עצמו לעולם לא
# בגיט; רק קובץ הדוגמה, שמסביר איך למלא אותו על מכונת ה-build.
# (ראה Parkomat.Agent/src/Parkomat.Agent.Core/Parkomat.Agent.Core.csproj)
Parkomat.Agent/agent-defaults.password
!Parkomat.Agent/agent-defaults.password.example
*.pem
*.key
*.pfx
*.p12
secrets.json
appsettings.Production.json
appsettings.Local.json

# ===== 🔴 מסדי נתונים ונתוני שדה =====
# sitemonitor.db מכיל טלמטריה אמיתית של אתרים. נוצר לבד מ-schema.sql.
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
backups/

# ===== תלויות (מותקנות מ-package.json) =====
node_modules/

# ===== תוצרי build =====
dist/
dist-ssr/
build/
.ssr-out/

# .NET
[Bb]in/
[Oo]bj/
publish/
installer-output/

# ===== סביבות פיתוח =====
.vs/
.vscode/*
!.vscode/extensions.json
.idea/
*.user
*.suo
*.ntvs*
*.njsproj
*.sw?

# ===== לוגים =====
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ===== מערכת הפעלה =====
.DS_Store
Thumbs.db
desktop.ini

# ===== זמניים =====
*.tmp
*.tmp.*
*.local
*.bak
*.pid

# תוצר בניית הדשבורד שמוגש ע"י ה-master (נבנה בתוך תמונת ה-Docker)
master/public/

# ⚠️ סוד האימות הדו-שלבי של המשתמש — לעולם לא לגיט (המאגר ציבורי).
.totp-secret

# קבצי עבודה זמניים של כלי עריכה — לא אמורים להיכנס
*-tmp.mjs
*-tmp.js

# קבצי עבודה זמניים של סקריפטים חד-פעמיים
.tmp-*
