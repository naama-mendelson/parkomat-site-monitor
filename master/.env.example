# ============================================================
# Parkomat Master — תבנית משתני סביבה (הרצה מקומית / פיתוח)
# ============================================================
# העתק לקובץ .env באותה תיקייה ומלא את הערכים:
#
#     cp .env.example .env
#     npm start
#
# ⚠️ .env עצמו מוחרג מגיט (ראה .gitignore) — הריפו הזה ציבורי, וסודות
# לא נכנסים אליו. הקובץ הזה הוא תבנית בלבד ואין בו אף סוד.
#
# להרצה בקונטיינר יש קובץ נפרד: ../.env.docker.example, שמועתק ל-.env
# **בשורש** הריפו (שם יושב ה-docker-compose.yml שקורא אותו). שני קבצים
# שונים, שני מקומות שונים — אל תתבלבל ביניהם.

# ===== חובה — בלעדיהם השרת נעצר מיד עם הודעה מפורשת =====

# Postgres של Supabase. חייב להיות ה-**pooler** בפורט 6543 (transaction mode):
# המארח הישיר (db.<ref>.supabase.co) הוא IPv6 בלבד ולא ייפתר מרשת IPv4, ו-session
# mode (5432) מוגבל ל-15 חיבורים לכל הפרויקט — תהליך נוסף לצד השרת גומר אותה.
DATABASE_URL=postgresql://USER:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres

# HiveMQ Cloud — ה-Master מאזין בלבד ואינו מפרסם.
HIVEMQ_HOST=xxxxxxxx.s1.eu.hivemq.cloud
HIVEMQ_PORT=8883
MASTER_USERNAME=master
MASTER_PASSWORD=

# ===== מומלץ =====

# מזהה הלקוח מול HiveMQ. קבוע (ולא אקראי) יחד עם clean:false, כדי שהברוקר
# ישמור את המנוי ואת הודעות ה-QoS 1 בזמן שהשרת למטה ויימסור אותן בהתחברות
# הבאה.
#
# ⚠️ חייב להיות **ייחודי ומפורש**, ולא שם גנרי כמו "master": לפי התקן, חיבור
# של כל לקוח אחר עם אותו מזהה ועם clean:true מוחק את ה-session ואת כל התור
# שבו — בשקט, בלי שגיאה. כך אבדו הודעות של 3.6 ימים ב-22-26/07/2026.
# אם רצות כמה סביבות (פיתוח/בדיקות/פרודקשן) — לכל אחת מזהה משלה, אחרת הן
# מוחקות זו את התור של זו.
MASTER_CLIENT_ID=parkomat-master-subscriber-dev

# פורט ה-API והדשבורד.
PORT=4000

# ===== אופציונלי =====

# רלוונטי רק אם הדשבורד מוגש מדומיין *אחר* מה-API. בפיתוח Vite עושה proxy
# ל-/api, ובקונטיינר הדשבורד מוגש מאותו origin — בשני המקרים אין צורך בזה.
# DASHBOARD_ORIGIN=http://localhost:5173

# ===== אופציונלי — עוזר ה-AI (פרקובוט) =====
# בלעדיהם הצ'אט מחזיר 503 מפורש ושאר המערכת עובדת רגיל.
# AI_PROVIDER=groq
# GROQ_API_KEY=
# GROQ_MODEL=

# ===== אופציונלי — שערי אימות (npm run gates) =====
#
# ⚠️ שלושה שערים בודקים את המסלול ש**באמת פועל היום**: הדשבורד קורא
# מ-PostgREST ישירות, ו-RLS מעניק קריאה ל-authenticated בלבד. בלי משתמש הם
# אינם יכולים לרוץ, ו-`npm run gates` יחזיר קוד 2 — "לא רץ", לא "עבר".
#
# משתמש רגיל מספיק (לא Secret key). קריאה בלבד.
# PARITY_EMAIL=
# PARITY_PASSWORD=
