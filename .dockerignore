# ============================================================
# מה *לא* נכנס להקשר הבנייה של Docker
# ============================================================

# תלויות ותוצרי בנייה — נבנים מחדש בתוך התמונה, ולעולם לא מועתקים מהמארח
# (node_modules של Windows מכיל בינאריים שלא ירוצו ב-Linux).
**/node_modules
dashboard/dist
master/public

# ============================================================
# הסוכן — לא שייך לשרת
# ============================================================
# Parkomat.Agent הוא אפליקציית Windows (.NET) שמותקנת ידנית על מחשב באתר
# החניה: היא צריכה גישה פיזית ל-PLC ברשת המקומית ול-Mosquitto מקומי, ולכן
# אין שום משמעות לארוז אותה בקונטיינר. בנוסף היא שוקלת מאות מגה
# (publish self-contained + מתקין 63MB) והייתה מנפחת כל בנייה.
Parkomat.Agent/

# סודות — לעולם לא נכנסים לתמונה. מוזרקים בזמן ריצה כמשתני סביבה.
# ⚠️ **גם בשורש, במפורש.** `**/.env` נשען על כך ש-`**` מתאים גם לאפס
# תיקיות — התנהגות שתלויה במימוש. שורה מפורשת הופכת את ההבטחה הזו
# לבלתי-תלויה בפרשנות, וההימור כאן הוא סודות בתוך התמונה.
.env
**/.env
**/.env.*
!**/.env.example

# ============================================================
# שאריות ה-SQLite — נתוני לקוח אמיתיים, ואסור שייכנסו לתמונה
# ============================================================
# הפרויקט היגר ל-Postgres, אבל קובצי ה-SQLite הישנים עדיין יושבים ב-master/
# (sitemonitor.db + WAL של ~1.4MB + גיבוי). הם מכילים טלמטריה אמיתית של אתרי
# לקוח, ו-`COPY master/ ./` היה אורז אותם לתוך התמונה — כלומר מפיץ נתוני לקוח
# בכל מקום שהתמונה מגיעה אליו (registry, שרת, מחשב של מי שעושה docker pull).
# הם גם מיותרים לחלוטין בזמן ריצה: שום קוד במסלול של master.js אינו קורא אותם.
**/*.db
**/*.db-wal
**/*.db-shm
**/sitemonitor.backup-*

# לוגים מקומיים של הרצות פיתוח — אין להם שום תפקיד בתמונה.
**/*.log
**/logs/

# בדיקות אינן חלק מתמונת הפרודקשן.
master/tests/

# פרויקט שנזנח
monitor-site/

# שונות שאינה נדרשת בזמן ריצה
.git
.gitignore
.claude/
**/*.md
**/bin
**/obj
