# syntax=docker/dockerfile:1
# ============================================================
# Parkomat — שרת (master) + דשבורד, בקונטיינר אחד
# ============================================================
# מה *לא* נמצא כאן, ובכוונה:
#   • בסיס נתונים — Postgres מנוהל ב-Supabase (חיצוני, דרך DATABASE_URL).
#   • ברוקר MQTT  — HiveMQ Cloud (חיצוני).
#   • הסוכן        — אפליקציית Windows שמותקנת ידנית באתרי החניה.
# ולכן זהו שירות אחד בלבד, בלי תלויות מקומיות.
#
# ============================================================
# ⚠️ מבנה התיקיות נשמר, ולא משוטח
# ============================================================
# זה **הדבר הקריטי בקובץ הזה**, והוא היה שבור: `shared/` יושבת מחוץ ל-master
# ומחוץ ל-dashboard, ושתיהן מייבאות ממנה:
#
#     master/db/queries.js          →  require("../../shared/executive.mjs")
#     dashboard/src/services/*.js   →  import  "../../../shared/timeline.mjs"
#
# הגרסה הקודמת עשתה `COPY master/ ./` ל-/app, ואז `../../shared` הצביע
# ל-`/shared` — מחוץ להקשר. **הבנייה הייתה נכשלת בשני השלבים**, וזה נמדד
# בסימולציה של הקשר הבנייה לפני שנכתב הקובץ הזה.
#
# הפתרון: העתקה ל-**תת-תיקיות בעלות אותם שמות** כמו ברפו, כך שכל נתיב יחסי
# נשאר בדיוק כפי שהוא. לא נוגעים בשורת import אחת.

# ------------------------------------------------------------
# שלב 1 — בניית הדשבורד (Vite → קבצים סטטיים)
# ------------------------------------------------------------
# ⚠️ node:24 ולא 22: `require()` של ESM — מה שמאפשר ל-shared/*.mjs לשרת גם את
# השרת (CommonJS) וגם את הדפדפן (ESM) — יציב מ-22.12, והפרויקט נבדק על
# v24.18.0. `node:22-alpine` היה עובד היום ומתגלגל אחורה ביום שהתגית תצביע
# על 22.11.
FROM node:24-alpine AS dashboard

WORKDIR /app

# מעתיקים קודם את קבצי התלויות בלבד: כל עוד הם לא משתנים, שכבת ה-npm ci
# נשלפת מהמטמון ובנייה חוזרת לוקחת שניות במקום דקות.
COPY dashboard/package*.json dashboard/
RUN cd dashboard && npm ci

# ⚠️ shared/ **לפני** הדשבורד: היא משתנה לעתים רחוקות יותר מקוד המסכים,
# ולכן שכבה נפרדת ומוקדמת שומרת על מטמון ה-npm ci בכל שינוי מסך.
COPY shared/ shared/
COPY dashboard/ dashboard/

# ============================================================
# ⚠️ משתני VITE מוטמעים בזמן ה**בנייה**, לא בזמן הריצה
# ============================================================
# זה הבדל שאי אפשר לעקוף: Vite מחליף כל `import.meta.env.VITE_X` בערך
# המילולי בזמן הבנייה. הזרקתם ל-compose כמשתני סביבה **לא תעשה דבר** —
# החבילה כבר נבנתה בלעדיהם.
#
# ⚠️ וזה נכשל **בשקט למחצה**: הדשבורד עולה, המסך נטען, ובמקום להתחבר הוא
# אומר "האימות אינו מוגדר בדשבורד". שרת תקין לגמרי, מסך שאי אפשר להיכנס בו.
#
# ⚠️ המפתח כאן הוא ה-**publishable/anon** בלבד. אסור בשום אופן להעביר לכאן
# את ה-secret key: הוא עוקף RLS, והוא היה נצרב לתוך קובץ JS שכל דפדפן מוריד.
#
# ברירת מחדל ריקה ולא ערך מומצא: בנייה בלי המשתנים מייצרת מסך שאומר מה
# חסר, במקום להתחבר לכתובת שגויה ולהחזיר שגיאות רשת מבלבלות.
ARG VITE_SUPABASE_URL=""
ARG VITE_SUPABASE_PUBLISHABLE_KEY=""
# ⚠️ "false" מחזיר את הדשבורד לקרוא דרך השרת (תוכנית ב'). ברירת המחדל היא
# קריאה ישירה מ-Supabase — ראה services/dataSource.js.
ARG VITE_SUPABASE_DIRECT="true"

ENV VITE_SUPABASE_URL=$VITE_SUPABASE_URL     VITE_SUPABASE_PUBLISHABLE_KEY=$VITE_SUPABASE_PUBLISHABLE_KEY     VITE_SUPABASE_DIRECT=$VITE_SUPABASE_DIRECT

RUN cd dashboard && npm run build          # → /app/dashboard/dist

# ------------------------------------------------------------
# שלב 2 — שרת ה-Master + הדשבורד הבנוי
# ------------------------------------------------------------
FROM node:24-alpine

ENV NODE_ENV=production

# ============================================================
# אזור זמן — לא קוסמטיקה
# ============================================================
# חישובי "פעילות לפי שעה ביום", "לפי יום בשבוע" וגבולות היום/החודש מחושבים
# ב-JS עם getHours()/getDay()/getDate(), כלומר לפי **השעון המקומי של השרת**.
# קונטיינר עולה כברירת מחדל ב-UTC, ולכן בלי ההגדרה הזו כל סטטיסטיקת השעות
# תיסוג ב-3 שעות (וקיץ/חורף), ופעולה ב-01:00 בלילה תיפול ליום הקודם.
# tzdata נדרש ב-alpine כדי ש-TZ בכלל ייקלט.
#
# ⚠️ אותו אזור זמן משמש גם ב-api/periods.js וגם בפונקציות ה-SQL. שינוי כאן
# בלי שינוי שם היה מפצל את גבולות התקופה בין שתי זרועות המתג.
ENV TZ=Asia/Jerusalem
RUN apk add --no-cache tzdata

# ============================================================
# ⚠️ אין כאן tini, ובכוונה — הוא מגיע מ-docker-compose
# ============================================================
# `init: true` ב-compose מזריק tini כ-PID 1. הוספתו גם כאן הייתה מריצה tini
# תחת tini, ודורסת את ה-ENTRYPOINT של תמונת node הרשמית בלי צורך.
#
# ⚠️ ולמי שמריץ בלי compose: `docker run --init ...`. בלי אחד מהשניים אין מי
# שיקצור תהליכי זומבי — Node אינו קוצר יתומים, ו-PID 1 חייב.
#
# ⚠️ מה ש**כן** עובד בלי שום init: הכיבוי המסודר. ההנמקה הנפוצה "PID 1 לא
# מקבל סיגנלים" אינה מדויקת — הכלל הוא ש-PID 1 מתעלם מסיגנלים שאין להם
# מטפל מפורש, ול-master.js יש (`process.on("SIGTERM")` שסוגר MQTT ומרוקן את
# תורי הקליטה).

WORKDIR /app

# ============================================================
# למה alpine בטוח כאן — נבדק, לא הונח
# ============================================================
# alpine בנוי על musl, ולכן כל מודול native מחייב קומפילציה מחדש. נבדק גרף
# ה-require של master.js: `pg` ו-`mqtt` הם JavaScript טהור (pg משתמש
# ב-pg-native רק אם הוא מותקן, והוא אינו), ולכן אין כאן שום תלות native.
#
# היחיד שכן native הוא better-sqlite3 — והוא ב-devDependencies ומשמש רק כלי
# מיגרציה שאינם על מסלול הריצה. --omit=dev מוציא אותו, ולכן אין צורך
# ב-python/gcc והתמונה נשארת קטנה.
#
# --chown: הקבצים מועתקים כברירת מחדל בבעלות root, והתהליך רץ כ-node (למטה).
# קריאה עובדת גם ככה, אבל בעלות מפורשת מונעת הפתעות אם משהו ירצה לכתוב.
COPY --chown=node:node master/package*.json master/
RUN cd master && npm ci --omit=dev && npm cache clean --force

COPY --chown=node:node shared/ shared/
COPY --chown=node:node master/ master/

# הדשבורד מוגש מאותו origin כמו ה-API. זה לא רק חיסכון בקונטיינר: הלקוח
# קורא ל-API בנתיב *יחסי* ("/api"), ולכן same-origin מייתר גם CORS וגם
# הגדרת כתובת-שרת בלקוח. routes.js מגיש את התיקייה אם היא קיימת.
COPY --from=dashboard --chown=node:node /app/dashboard/dist master/public

WORKDIR /app/master

# ============================================================
# עשן בזמן בנייה — שתי הנחות שהיו שבורות, נבדקות כאן
# ============================================================
# ⚠️ **בדיוק הבדיקה הזו הייתה תופסת את הבאג שהיה כאן.** `shared/` לא הועתקה,
# והכשל היה מתגלה רק בעלייה הראשונה על שרת — כלומר אצל מישהו אחר, ביום
# הפריסה. שלוש שורות בבנייה הופכות את זה לכשל מיידי וברור.
#
# שתי הנחות נבדקות בבת אחת, ושתיהן היו נקודות אמיתיות:
#   1. **הנתיבים** — `../shared/...` נפתר מתוך /app/master.
#   2. **`require()` של ESM** — הקבצים האלה הם .mjs, והשרת CommonJS. זה
#      עובד מ-Node 22.12 בלבד. תמונת בסיס שתתגלגל אחורה תיפול **כאן**,
#      ולא בעלייה בייצור.
#
# ⚠️ נבדקים רק המודולים המשותפים ולא db/queries.js: הוא טוען את db.js,
# שדורש DATABASE_URL בזמן טעינה — ואין סוד בזמן בנייה, ובצדק.
RUN node -e "require('../shared/timeline.mjs'); \
             require('../shared/insights.mjs'); \
             require('../shared/executive.mjs'); \
             console.log('✅ shared נטען: נתיבים תקינים, require(ESM) עובד')"

EXPOSE 4000

# ============================================================
# לא רץ כ-root
# ============================================================
# משתמש 'node' (uid 1000) כבר קיים בתמונת node הרשמית — זו הדרך המקובלת,
# ואין צורך ליצור עוד אחד. מכאן והלאה כל פקודה רצה כמשתמש הזה.
USER node

# ============================================================
# בדיקת חיות — /health, לא '/'
# ============================================================
# קודם היא ביקשה את '/' — כלומר בדקה רק שהשרת הסטטי עונה. Master שמגיש את
# הדשבורד אבל מנותק מ-HiveMQ, או שהסכמה שלו לא אותחלה, היה נחשב "בריא".
# /health בודק את המצב האמיתי (DB מוכן + MQTT מחובר) ואינו נוגע ב-DB, ולכן
# הוא גם לא עולה כלום.
#
# start-period=40s ולא 20: העלייה כוללת אתחול סכמה מול Supabase והתחברות
# ל-HiveMQ, ושניהם מעבר לרשת. סף קצר מדי היה מסמן unhealthy בזמן עלייה תקינה.
HEALTHCHECK --interval=30s --timeout=5s --start-period=40s --retries=3 \
  CMD node -e "require('http').get('http://127.0.0.1:'+(process.env.PORT||4000)+'/health',r=>process.exit(r.statusCode===200?0:1)).on('error',()=>process.exit(1))"

CMD ["node", "master.js"]
