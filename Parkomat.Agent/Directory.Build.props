<Project>

  <!--
    ============================================================
    ⚠️ מספר הגרסה — מקור אחד לשלושה מקומות
    ============================================================
    הגרסה הופיעה בשלושה קבצים, ושניים מהם הסכימו: שני ה-csproj אמרו
    1.0.20 ו-installer.iss אמר 1.0.21. כלומר ה-installer הכריז על גרסה
    שהבינאריים שבתוכו אינם נושאים.

    ⚠️ **וזה אינו פרט קוסמטי.** installer.iss עצמו מתעד למה: מספר הגרסה
    הוא הדרך **היחידה** לדעת איזה סוכן מותקן באיזה אתר — הסוכן אינו משדר
    את גרסתו בשום topic, ולוח הבקרה של Windows הוא המקום היחיד שבו רואים
    אותה. גרסה שאינה תואמת למה שבפנים הופכת את השאלה "האם האתר הזה כבר
    עודכן?" לבלתי ניתנת לתשובה, וזה בדיוק המצב שבו מעדכנים אתר פעמיים
    ומדלגים על אחר.

    ⚠️ הקובץ הזה נטען אוטומטית על ידי MSBuild לכל פרויקט תחת התיקייה, ולכן
    ה-csproj-ים כבר **לא** מכריזים Version משלהם. את installer.iss אי אפשר
    לחבר לכאן (הוא Inno Setup ולא MSBuild), ולכן AgentVersionTests נועל
    את השוויון ביניהם — והוא ייפול ברגע שאחד מהם יזוז לבד.
  -->
  <PropertyGroup>
    <Version>1.0.24</Version>
  </PropertyGroup>

</Project>
