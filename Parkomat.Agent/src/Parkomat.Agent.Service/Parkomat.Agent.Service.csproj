<Project Sdk="Microsoft.NET.Sdk.Worker">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Version>1.0.20</Version>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>dotnet-Parkomat.Agent.Service-cd2d6f0d-883a-4e07-8b16-eed3cf1391fb</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.9" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.9" />
    <PackageReference Include="MQTTnet" Version="5.1.0.1559" />
    <PackageReference Include="NModbus" Version="3.0.83" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Parkomat.Agent.Core\Parkomat.Agent.Core.csproj" />
  </ItemGroup>

  <!-- ============================================================
       פרסום עצמאי — זמן הריצה נארז בפנים
       ============================================================
       ⚠️ בלי זה הקובץ שנוצר הוא framework-dependent: הוא **דורש ש-.NET 10
       יהיה מותקן על המחשב**, ועל מכונה שאין בה אותו הוא עולה עם הודעה
       "You must install .NET to run this application".
       .NET 10 חדש מאוד, ורוב מחשבי האתרים לא ראו אותו מעולם.

       הסוכן מותקן ידנית על מחשבים באתרי חניה שאיננו שולטים בהם — כל תלות
       חיצונית שם היא ביקור טכנאי.

       ⚠️ **וזה יושב כאן ולא בשורת הפקודה בכוונה.** הפרסום נעשה כבר פעם אחת
       בלי הדגל, והתוצאה הייתה תיקייה שמערבבת זמן ריצה ישן עם אפליקציה
       שמבקשת אותו מבחוץ — מתקין ששקט ונשבר רק אצל הלקוח.
       דגל בשורת פקודה נשכח; שורה בקובץ הפרויקט לא.

       ⚠️ ללא Trimming: גיזום מסיר טיפוסים שנטענים ברפלקציה, וזה כשל
       שמתגלה רק בזמן ריצה — באתר. -->
  <PropertyGroup>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>

</Project>
